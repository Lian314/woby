page {
  background: #f4ede0;
}

.page {
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

.intro {
  padding: 8rpx 4rpx 22rpx;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1d21;
}

.intro-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #8d877b;
}

.section {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fffaf0;
  border: 1rpx solid #e6dcc9;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1b1d21;
}

.hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8d877b;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #5b5a55;
}

.text-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e6dcc9;
  background: #f8f3e9;
  font-size: 26rpx;
  color: #1b1d21;
}

.placeholder {
  color: #b0a897;
}

.key-row {
  display: flex;
  align-items: center;
}

.key-input {
  flex: 1;
}

.eye {
  margin-left: 8rpx;
  padding: 18rpx 12rpx;
  font-size: 24rpx;
  color: #2e6b5e;
}

.prompt-input {
  width: 100%;
  min-height: 150rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e6dcc9;
  background: #f8f3e9;
  font-size: 26rpx;
  line-height: 1.6;
  color: #1b1d21;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid #eee6d7;
}

.switch-copy {
  padding-right: 20rpx;
}

.switch-title {
  font-size: 27rpx;
  color: #1b1d21;
}

.switch-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9a958a;
}

.link-row {
  padding: 12rpx 0;
  font-size: 25rpx;
  color: #a63a2b;
}

.about {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #9a958a;
}

.save-btn {
  width: 100%;
  margin-top: 8rpx;
  padding: 0;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
  border-radius: 999rpx;
  background: #2e6b5e;
  color: #fffdf8;
  font-size: 28rpx;
  font-weight: 600;
}

.save-hover {
  opacity: 0.8;
}

.bottom-space {
  height: 40rpx;
}
