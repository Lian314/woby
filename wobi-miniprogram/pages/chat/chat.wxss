page {
  background: #f4ede0;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f4ede0;
}

.topbar {
  flex-shrink: 0;
  height: 96rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(27, 29, 33, 0.08);
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-mark-sm {
  width: 52rpx;
  height: 52rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
  background: #191b1f;
  color: #f6efe2;
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-name {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.top-actions {
  display: flex;
  align-items: center;
}

.model-pill {
  max-width: 300rpx;
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fffaf0;
  border: 1rpx solid #e6dcc9;
}

.model-name {
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  color: #5b5a55;
}

.model-arrow {
  margin-left: 6rpx;
  color: #9a958a;
  font-size: 22rpx;
}

.new-btn {
  margin-left: 8rpx;
  padding: 12rpx 0 12rpx 16rpx;
  font-size: 24rpx;
  color: #2e6b5e;
}

.messages {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}

.messages-inner {
  padding: 24rpx 28rpx 30rpx;
}

.empty {
  padding: 80rpx 8rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-mark {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 34rpx;
  background: linear-gradient(140deg, #191b1f, #3a3d42);
  color: #f6efe2;
  font-family: "Songti SC", "STSong", serif;
  font-size: 64rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.seal-dot {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 8rpx;
  background: #a63a2b;
  border: 3rpx solid #f4ede0;
}

.empty-title {
  margin-top: 22rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.empty-sub {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #8d877b;
  text-align: center;
}

.setup-btn {
  margin-top: 28rpx;
  padding: 16rpx 34rpx;
  border-radius: 999rpx;
  background: #2e6b5e;
  color: #fffdf8;
  font-size: 26rpx;
}

.suggestions {
  width: 100%;
  margin-top: 44rpx;
}

.suggestion {
  margin-bottom: 14rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  background: #fffaf0;
  border: 1rpx solid #e6dcc9;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.suggestion-hover {
  background: #f8f1e4;
}

.suggestion-text {
  font-size: 26rpx;
  color: #3d3b36;
}

.suggestion-arrow {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #b0a897;
}

.row {
  display: flex;
  margin-bottom: 24rpx;
}

.row.user {
  justify-content: flex-end;
}

.row.assistant {
  justify-content: flex-start;
}

.bubble-wrap {
  max-width: 86%;
  display: flex;
  flex-direction: column;
}

.row.user .bubble-wrap {
  align-items: flex-end;
}

.message-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.message-image {
  width: 180rpx;
  height: 180rpx;
  margin: 0 10rpx 10rpx 0;
  border-radius: 20rpx;
  background: #e6dcc9;
}

.bubble {
  padding: 20rpx 26rpx;
  border-radius: 28rpx;
  font-size: 30rpx;
  line-height: 1.65;
}

.bubble.assistant {
  background: #fffdf8;
  border: 1rpx solid #e8dfcf;
  color: #1b1d21;
  border-top-left-radius: 10rpx;
}

.bubble.user {
  background: #2e6b5e;
  color: #fffdf8;
  border-top-right-radius: 10rpx;
}

.bubble.error {
  color: #a63a2b;
}

.bubble-text {
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble.waiting {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #b8b0a2;
  animation: wobi-blink 1.2s infinite;
}

.dot-2 {
  animation-delay: 0.2s;
}

.dot-3 {
  animation-delay: 0.4s;
  margin-right: 0;
}

@keyframes wobi-blink {
  0%,
  80%,
  100% {
    opacity: 0.25;
    transform: translateY(0);
  }
  40% {
    opacity: 1;
    transform: translateY(-3rpx);
  }
}

.bottom-anchor {
  height: 2rpx;
}

.composer {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  padding-bottom: 16rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #f4ede0;
  border-top: 1rpx solid rgba(27, 29, 33, 0.06);
}

.pending {
  width: 100%;
  height: 136rpx;
  margin-bottom: 12rpx;
  white-space: nowrap;
}

.pending-inner {
  display: flex;
  padding-top: 14rpx;
}

.pending-item {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.pending-image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 18rpx;
  background: #e6dcc9;
}

.remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(27, 29, 33, 0.72);
  color: #fff;
  font-size: 26rpx;
  line-height: 34rpx;
  text-align: center;
}

.composer-row {
  display: flex;
  align-items: flex-end;
}

.photo-btn {
  width: 72rpx;
  height: 72rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #fffaf0;
  border: 1rpx solid #e6dcc9;
  color: #2e6b5e;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.input {
  flex: 1;
  min-height: 72rpx;
  max-height: 240rpx;
  padding: 18rpx 26rpx;
  background: #fffaf0;
  border: 1rpx solid #e6dcc9;
  border-radius: 36rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1b1d21;
}

.input-placeholder {
  color: #a39c8e;
}

.send-btn {
  min-width: 100rpx;
  height: 72rpx;
  margin-left: 14rpx;
  padding: 0 24rpx;
  flex-shrink: 0;
  border-radius: 36rpx;
  background: #e8dfcf;
  color: #8d877b;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn.active {
  background: #2e6b5e;
  color: #fffdf8;
}

.send-btn.stop {
  background: #a63a2b;
  color: #fffdf8;
}

.tap-hover {
  opacity: 0.72;
}
